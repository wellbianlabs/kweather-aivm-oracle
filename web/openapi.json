{
  "openapi": "3.0.3",
  "info": {
    "title": "K-Weather × AIVM On-Chain Weather Oracle API",
    "version": "1.0.0",
    "description": "Real-time weather for 4,255 world cities, purchasable on-chain by AI agents. See /llms.txt for the agent guide and settlement model."
  },
  "servers": [{ "url": "https://kweather-aivm-oracle-wellbianlabs.vercel.app" }],
  "paths": {
    "/api/catalog": {
      "get": {
        "summary": "Search the 4,255-city catalog",
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "city name fragment" },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "matching cities with id (on-chain region code), country, lat, lon" } }
      }
    },
    "/api/quote": {
      "get": {
        "summary": "Pricing, contracts, settlement token, how-to-consume",
        "responses": { "200": { "description": "live quote" } }
      }
    },
    "/api/weather": {
      "get": {
        "summary": "Free real-time weather preview (24h series)",
        "parameters": [
          { "name": "lat", "in": "query", "required": true, "schema": { "type": "number" } },
          { "name": "lon", "in": "query", "required": true, "schema": { "type": "number" } },
          { "name": "code", "in": "query", "schema": { "type": "string" }, "description": "city id / region code" },
          { "name": "worldcode", "in": "query", "schema": { "type": "string" }, "description": "K-Weather world city code (optional)" }
        ],
        "responses": { "200": { "description": "{ source, series: [hourly observations] }" } }
      }
    },
    "/api/relay": {
      "get": {
        "summary": "Publish a city's current weather on-chain (relayer-signed)",
        "parameters": [
          { "name": "id", "in": "query", "schema": { "type": "string" } },
          { "name": "lat", "in": "query", "schema": { "type": "number" } },
          { "name": "lon", "in": "query", "schema": { "type": "number" } }
        ],
        "responses": { "200": { "description": "{ ok, txHash, block }" } }
      }
    },
    "/api/agent": {
      "get": {
        "summary": "Autonomous agent demo: subscribes, pays, queries on-chain, returns a decision",
        "parameters": [
          { "name": "product", "in": "query", "schema": { "type": "string" }, "description": "decision product id (default heat-demand-response)" }
        ],
        "responses": { "200": { "description": "agent activity + decision + tx hashes" } }
      }
    },
    "/api/decision": {
      "get": {
        "summary": "On-chain weather decision products",
        "description": "Reads the oracle's stored observations for a city and runs decision products (energy, agriculture, insurance, logistics, safety, tourism). No params -> product catalog. Falls back to the live feed for cities not yet on-chain.",
        "parameters": [
          { "name": "city", "in": "query", "schema": { "type": "string" }, "description": "city name or on-chain id; omit for the catalog" },
          { "name": "product", "in": "query", "schema": { "type": "string" }, "description": "decision product id; omit to run all" },
          { "name": "code", "in": "query", "schema": { "type": "string" } },
          { "name": "lat", "in": "query", "schema": { "type": "number" } },
          { "name": "lon", "in": "query", "schema": { "type": "number" } }
        ],
        "responses": { "200": { "description": "{ city, regionCode, source, observation, decisions:[{product, signal, action, score, rationale, metrics}] }" } }
      }
    },
    "/api/paid-weather": {
      "get": {
        "summary": "x402 keyless pay-per-call weather (HTTP 402) — multi-asset",
        "description": "No API key. First call -> 402 with an accepts[] menu of settlement assets (x402USD / USDT via EIP-3009 gasless, or USDT via Uniswap Permit2 for the real-USDT rail; each accepts entry has extra.id/symbol/settlement). Pick one, sign it (EIP-3009 TransferWithAuthorization or Permit2 SignatureTransfer), and retry with the X-PAYMENT header; the server settles on-chain and returns the data.",
        "parameters": [
          { "name": "city", "in": "query", "schema": { "type": "string" } },
          { "name": "lat", "in": "query", "schema": { "type": "number" } },
          { "name": "lon", "in": "query", "schema": { "type": "number" } },
          { "name": "X-PAYMENT", "in": "header", "schema": { "type": "string" }, "description": "base64 x402 exact-scheme payment payload" }
        ],
        "responses": {
          "402": { "description": "Payment Required — body has { x402Version, accepts:[paymentRequirements] }" },
          "200": { "description": "weather + settlement (tx); X-PAYMENT-RESPONSE header" }
        }
      }
    }
  },
  "x-mcp": {
    "server": "kweather-aivm-oracle",
    "entry": "mcp/server.mjs",
    "tools": ["search_cities", "get_weather", "get_pricing", "get_account", "get_oracle_status", "faucet_kwt", "subscribe", "deposit_prepaid", "buy_weather"]
  }
}
