# ── K-Weather Premium API ───────────────────────────────────────────────
# If set, the oracle node pulls REAL premium data from the K-Weather gateway.
# If unset, it uses a deterministic mock so everything still runs end-to-end.
KWEATHER_API_KEY=
# Gateway base (path form: {URL}/{sensor}/{법정동코드}?api_key=KEY). Override only
# if your contract uses a different host.
KWEATHER_API_URL=https://gateway.kweather.co.kr:8443/weather/w3/v2/kw-sensors
KWEATHER_TIMEOUT_MS=8000

# ── Target network (deploy / live relayer) ──────────────────────────────
RPC_URL=http://127.0.0.1:8545
DEPLOYER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=

# ── Relayer service ─────────────────────────────────────────────────────
DEPLOYMENT_FILE=deployments.custom.json
RELAY_INTERVAL_MS=3600000
