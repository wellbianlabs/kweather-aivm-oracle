# ── K-Weather × AIVM Oracle — environment (copy to .env) ──
# IMPORTANT: no inline comments after a value — systemd EnvironmentFile keeps them
# as part of the value. Put comments on their own line (like this one).

# Self-host server (server.js)
PORT=8080
# SELF_URL auto = http://127.0.0.1:$PORT for internal calls; override only if needed.
# SELF_URL=http://127.0.0.1:8080
# ENABLE_CRON=true -> built-in hourly relay+agent (else use system cron, see DEPLOY.md)
ENABLE_CRON=false

# ── K-Weather gateway (SECRET key required for real data) ──
KWEATHER_API_URL=https://gateway.kweather.co.kr:8443/weather/w3/v2/kw-sensors
KWEATHER_API_KEY=__your_kweather_api_key__
KWEATHER_TIMEOUT_MS=8000

# ── Chain (BNB Smart Chain testnet, chainId 97) ──
RPC_URL=https://bsc-testnet-rpc.publicnode.com
# RPC_URL_MAINNET (only if X402_ENABLE_MAINNET=true):
# RPC_URL_MAINNET=https://bsc-dataseed.binance.org

# ── Contracts (public addresses — keep as-is unless you redeploy) ──
# ORACLE_ADDRESS = world oracle | KOREA_ORACLE_ADDRESS = Korea 동단위 oracle | TOKEN_ADDRESS = KWT
ORACLE_ADDRESS=0x2A2b4B6530ef062c80fCeEc23ae0d6167eAe9630
KOREA_ORACLE_ADDRESS=0xb303D062e079365479513a951777a35a353b32de
SUBSCRIPTION_ADDRESS=0xA34D6B699f16ed574A574a3E2b18ce063da4d911
TOKEN_ADDRESS=0x04090599Dbaa990eabC37fFBDE223A4eD02e5b20
TREASURY=0x77AC0aa9bE15b6272D54Df10Dc24EECAAc77f9db

# ── Signers (SECRET — funded testnet wallets) ──
# RELAYER_PRIVATE_KEY publishes weather on-chain (needs tBNB gas)
# AGENT_PRIVATE_KEY runs the autonomous agent (needs KWT + tBNB)
# DEPLOYER_PRIVATE_KEY only for (re)deploying contracts via hardhat
RELAYER_PRIVATE_KEY=__relayer_private_key__
AGENT_PRIVATE_KEY=__agent_private_key__
# DEPLOYER_PRIVATE_KEY=

# ── x402 keyless pay-per-call ──
X402_PAYTO=0x77AC0aa9bE15b6272D54Df10Dc24EECAAc77f9db
X402_ENABLE_MAINNET=false

# ── Standalone relayer service (optional, scripts/relayer-service.js) ──
DEPLOYMENT_FILE=deployments.bscTestnet.json
RELAY_INTERVAL_MS=3600000
